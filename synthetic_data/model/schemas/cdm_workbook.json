            "neutral",
            "terse"
          ],
          "title": "Register",
          "type": "string"
        },
        "subtitle": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
