{
  "$defs": {
    "Block": {
      "additionalProperties": false,
      "description": "Discriminated by ``kind``; validators enforce exactly one payload shape.",
      "properties": {
        "block_id": {
          "maxLength": 200,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9_]*:[A-Za-z0-9][A-Za-z0-9:._/\\-]*$",
          "title": "Block Id",
          "type": "string"
        },
        "footnote_refs": {
          "anyOf": [
            {
              "items": {
                "maxLength": 200,
                "minLength": 3,
                "pattern": "^[a-z][a-z0-9_]*:[A-Za-z0-9][A-Za-z0-9:._/\\-]*$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Footnote Refs"
        },
        "items": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ListItem"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Items"
        },
        "kind": {
          "enum": [
            "paragraph",
            "list",
            "table",
            "note",
            "page_break",
            "signature",
            "exhibit",
            "header",
            "footer"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ordered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ordered"
        },
        "runs": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/InlineRun"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runs"
        },
        "table": {
          "anyOf": [
            {
              "$ref": "#/$defs/Table"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "block_id",
        "kind"
      ],
      "title": "Block",
      "type": "object"
    },
    "CellFormula": {
      "additionalProperties": false,
      "description": "Spreadsheet formula with its cached result.\n\nThe cached value is what a reader sees without recalculation; it must agree\nwith the cell's typed ``value`` so a formula can never disagree with the\nsemantic fact the cell references.",
      "properties": {
        "cached_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "$ref": "#/$defs/Percentage"
            },
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Cached Value"
        },
        "formula": {
          "maxLength": 400,
          "minLength": 2,
          "pattern": "^=",
          "title": "Formula",
          "type": "string"
        },
        "recalc_on_load": {
          "default": false,
          "title": "Recalc On Load",
          "type": "boolean"
        }
      },
      "required": [
        "formula",
        "cached_value"
      ],
      "title": "CellFormula",
      "type": "object"
    },
    "ColumnSpec": {
      "additionalProperties": false,
      "description": "Column-level type is an *expectation*, never a coercion (DEC-11).\n\nCell values are authoritative.  A homogeneous column may declare its type;\na heterogeneous column declares ``mixed``; leaving it ``None`` also means no\nexpectation.  Typed cells that disagree with a concrete declaration are\nrejected rather than converted.",
      "properties": {
        "align": {
          "default": "left",
          "enum": [
            "left",
            "right",
            "center"
          ],
          "title": "Align",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "enum": [
                "text",
                "money",
                "date",
                "percent",
                "int",
                "mixed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        },
        "width_hint": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width Hint"
        }
      },
      "required": [
        "name"
      ],
      "title": "ColumnSpec",
      "type": "object"
    },
